schemaVersion: 2.2.2
metadata:
  name: php-hello-world
  attributes:
    controller.devfile.io/pod-overrides:
      spec:
        volumes:
          - name: direct-nfs-mount
            nfs:
              server: 192.168.1.202
              path: /nfs_share
              readOnly: false
components:
  - name: developer-ww-workspace
    container:
      image: registry.redhat.io/devspaces/udi-rhel9:3.22
      memoryLimit: '2Gi'
      memoryRequest: '1Gi'
      cpuLimit: '1'
      cpuRequest: '0.5'
      # Force security context clearance for network-attached filesystems
      securityContext:
        runAsUser: 0 # Runs container processes as root to allow NFS binding
        privileged: true
      volumeMounts:
        - name: direct-nfs-mount
          path: /data

  - name: direct-nfs-mount
    volume:
      size: 10Gi
commands:
  - id: run
    exec:
      label: "Run the application"
      component: tools
      workingDir: ${PROJECTS_ROOT}/php-hello-world
      commandLine: php hello-world.php
      group:
        kind: run
